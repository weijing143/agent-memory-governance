  root -> skill;
  root -> readme;
  root -> changelog;
  root -> license;
  root -> scripts_dir;
  root -> refs_dir;
  scripts_dir -> script;
  refs_dir -> integ;
  refs_dir -> report;
  refs_dir -> blueprint;
  refs_dir -> openclaw;
  refs_dir -> semi;
}
