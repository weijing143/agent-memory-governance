digraph G {
  graph [rankdir=TB, bgcolor=white, fontname="WenQuanYi Zen Hei", fontsize=13, nodesep=0.3, ranksep=0.4, pad=0.3];
  node [fontname="WenQuanYi Zen Hei", fontsize=11, style="rounded,filled", color="#64748B", penwidth=1.2, shape=box, margin="0.15,0.08"];
  edge [color="#94A3B8", arrowsize=0.6];

  root [label="agent-memory-governance\n(私有仓库 · main · v1.2.3)", shape=folder, fillcolor="#1E293B", fontcolor="white", fontsize=13, penwidth=2];

  skill  [label="SKILL.md\n治理指南本体", fillcolor="#DCFCE7", color="#16A34A"];
  readme [label="README.md\n双语简介 + 结构图"];
