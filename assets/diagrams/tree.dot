  refs_dir [label="references/", shape=folder, fillcolor="#FEF3C7", color="#F59E0B"];
  integ  [label="hermes-integration.md\nHermes 落地指南"];
  report [label="hermes-practice-report.md\n实践验证报告 (8 条教训)"];
  blueprint [label="implementation-blueprint.md\n实施蓝图"];
